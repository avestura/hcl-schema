{
  "name": "hcl-schema",
  "publisher": "avestura",
  "displayName": "HCL Schema",
  "description": "Validation, completion and hover for HCL files described by .schema.hcl",
  "icon": "assets/hashicorp_logo_mark_light_universal_radius45.png",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "HashiCorp",
    "devops",
    "hcl",
    "schema"
  ],
  "bugs": {
    "url": "https://github.com/avestura/hcl-schema/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avestura/hcl-schema.git"
  },
  "homepage": "https://github.com/avestura/hcl-schema",
  "galleryBanner": {
    "color": "#FFF",
    "theme": "light"
  },
  "extensionDependencies": [
    "hashicorp.hcl"
  ],
  "activationEvents": [
    "onLanguage:hcl",
    "workspaceContains:**/*.schema.hcl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hcl-schema.validateActive",
        "title": "HCL Schema: Validate active file"
      },
      {
        "command": "hcl-schema.restart",
        "title": "HCL Schema: Restart language server"
      },
      {
        "command": "hcl-schema.showOutput",
        "title": "HCL Schema: Show output"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "HCL Schema",
      "properties": {
        "hclSchema.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the hclschema binary. Leave empty to use the one bundled with this extension."
        },
        "hclSchema.strict": {
          "type": "boolean",
          "default": false,
          "description": "Apply draft 2026-09 rules even to schemas that pin an older draft."
        },
        "hclSchema.offline": {
          "type": "boolean",
          "default": false,
          "description": "Never fetch remote schemas; serve them from the local cache only."
        },
        "hclSchema.cacheDir": {
          "type": "string",
          "default": "",
          "description": "Directory for cached remote schemas. Leave empty for the per-user cache directory."
        }
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "vscode:prepublish": "node ./scripts/prepublish.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:go-cli": "node ./scripts/build-go-cli.js",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "node ./scripts/package.js",
    "package:all": "node ./scripts/package.js --all"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
